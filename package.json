{
  "name": "dsh-math2-study",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Math II tutor and learning dashboard for DeepSeek Harness.",
  "engines": { "node": ">=24", "dsh": "^0.2.2-rc.5" },
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./tools": "./tools.mjs",
    "./client": "./client.js",
    "./icon": "./icon.png",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.mjs", "tools.mjs", "study.mjs", "client.js", "cordis.patch.yml",
    "guidance", "locale", "icon.png", "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "scripts": { "test": "node --test tests/*.test.mjs" }
}
